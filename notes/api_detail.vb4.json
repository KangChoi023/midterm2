    "imgsz",
    "입력 크기"
   ],
   [
    "conf",
    "점수 기준"
   ],
   [
    "classes",
    "남길 클래스 번호 목록"
   ]
  ],
  "flow": "letterbox → 추론 → NMS",
  "ret": "Results 목록"
 },
 "cv2.resize()": {
  "role": "이미지 크기 바꾸기",
  "desc": [
