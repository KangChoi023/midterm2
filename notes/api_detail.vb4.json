    "imgsz",
    "입력 크기"
   ],
   [
    "conf",
    "점수 기준"
   ]
  ],
  "flow": "predict → 박스 · 점수 · 시간 추출",
  "ret": "`(boxes, scores, speed)`"
 },
 "process_video()": {
  "role": "영상 전체에 탐지 → 결과 영상",
