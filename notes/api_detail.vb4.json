    "왼쪽 아래 좌표"
   ],
   [
    "fontFace",
    "글꼴"
   ],
   [
    "fontScale",
    "크기"
   ],
   [
    "color",
    "BGR 색"
   ],
   [
    "thickness",
    "두께"
   ]
  ],
  "flow": "이미지 위에 글자",
  "ret": "이미지"
 },
 "predict_dataset()": {
  "role": "데이터셋 전체를 예측해 평가용 목록 만들기",
