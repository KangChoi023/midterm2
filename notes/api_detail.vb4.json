   ],
   [
    "dsize",
    "(폭, 높이)"
   ],
   [
    "interpolation",
    "보간 방식 (`INTER_LINEAR`)"
   ]
  ],
  "flow": "이미지 → 새 크기",
  "ret": "이미지"
 },
 "detect_people()": {
  "role": "프레임 한 장에서 사람 찾기",
