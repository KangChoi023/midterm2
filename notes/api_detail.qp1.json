 "calc_scale_zp()": {
  "role": "실수 범위 → scale · zero_point",
  "desc": [
   "먼저 범위에 0 포함 (min(xmin, 0), max(xmax, 0))",
   "scale = (xmax − xmin) / (qmax − qmin), zp = qmin − round(xmin / scale) (정수, 범위 안)",
   "모두 0 이면 (1.0, qmin)"
  ],
  "args": [
   [
    "xmin, xmax",
    "실수 범위"
   ],
   [
    "qmin, qmax",
    "정수 범위 (기본 0, 255 = UINT8)"
   ]
  ],
  "flow": "−1 ~ 3 → (4/255, 64)",
  "ret": "(scale, zp) — float, int",
  "hdr": "3교시 직접 구현 (my_quant.py)",
  "ex": ""
 },
 "quantize()": {
  "role": "실수 → 정수 (affine)",
  "desc": [
   "q = clip(round(x / scale) + zp, qmin, qmax)",
   "INT32 배열로 돌려줌 — 계산 중 wrap-around 방지, 저장할 때만 8비트"
  ],
  "args": [
   [
    "x",
    "실수 배열"
   ],
   [
    "scale, zp",
    "calc_scale_zp 결과"
   ],
   [
    "qmin, qmax",
    "정수 범위"
   ]
  ],
  "flow": "[−1, 0, 0.5, 1.234, 3] → [0, 64, 96, 143, 255]",
  "ret": "ndarray (int32)",
  "hdr": "3교시 직접 구현 (my_quant.py)",
  "ex": ""
 },
 "dequantize()": {
  "role": "정수 → 실수 (affine)",
  "desc": [
   "x̂ = (q − zp) × scale",
   "범위 안 왕복 오차 ≤ scale/2, 0 은 정확히 0"
  ],
  "args": [
   [
    "q",
    "정수 배열"
   ],
   [
    "scale, zp",
    "양자화에 쓴 값"
   ]
  ],
  "flow": "64 → 0.0, 255 → 2.996",
  "ret": "ndarray (float64)",
  "hdr": "3교시 직접 구현 (my_quant.py)",
  "ex": ""
 },
 "sym_scale()": {
  "role": "대칭 양자화 scale",
  "desc": [
   "scale = max|x| / qmax, qmax = 2^(bits−1) − 1 (8비트 127)",
   "zp 는 없음 (항상 0)"
  ],
  "args": [
   [
    "x",
    "배열"
   ],
   [
    "bits",
    "비트 수 (기본 8)"
   ]
  ],
  "flow": "[−2, −0.5, 0, 1] → 2/127",
  "ret": "float",
  "hdr": "4교시 직접 구현 (my_quant.py)",
  "ex": ""
 },
 "sym_quantize()": {
  "role": "대칭 양자화 (zp = 0)",
  "desc": [
   "q = clip(round(x / scale), −qmax, qmax) → INT32",
   "되돌리기는 q × scale 만 (zp 를 빼지 않음)",
   "−128 은 쓰지 않음 → 0 중심 대칭"
  ],
  "args": [
   [
    "x",
    "배열"
   ],
   [
    "scale",
    "sym_scale 결과"
   ],
   [
    "bits",
    "비트 수"
   ]
  ],
  "flow": "[−2, −0.5, 0, 1] → [−127, −32, 0, 64]",
  "ret": "ndarray (int32)",
  "hdr": "4교시 직접 구현",
  "ex": ""
 },
