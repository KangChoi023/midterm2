{
 "_설명": "VB Day 5 함수 상세",
 "np.unique()": {
  "role": "배열에 들어 있는 서로 다른 값 목록",
  "desc": [
   "마스크에 쓰인 값(0 = 배경, 1 · 2 = 사람)을 확인",
   "정렬된 1차원 배열로 돌려줌"
  ],
  "args": [
   [
    "ar",
    "값을 볼 배열"
   ]
  ],
  "flow": "평탄화 → 중복 제거 → 정렬",
  "ret": "ndarray",
  "hdr": "import numpy as np"
 },
 "mask_box()": {
  "role": "마스크 → 둘러싸는 박스",
  "desc": [
   "`np.where` 로 True 인 위치를 찾고 최솟값 · 최댓값을 박스로",
   "마스크에서 박스는 바로 나온다 (반대는 불가)"
  ],
  "args": [
   [
    "m",
    "True/False 마스크 (H×W)"
   ]
  ],
  "flow": "where → (xs.min, ys.min, xs.max, ys.max)",
  "ret": "xyxy 배열"
 },
 "tconv_out()": {
  "role": "Transposed Conv 출력 크기",
  "desc": [
   "`(n − 1)·s − 2p + k`",
   "n = 8, k4 s2 p1 → 16 · k3 s2 p1 → 15"
  ],
  "args": [
   [
    "n",
    "입력 한 변"
   ],
   [
    "k, s, p",
    "커널 · stride · padding"
   ]
  ],
  "flow": "공식 계산",
  "ret": "int"
 },
 "nn.ConvTranspose2d()": {
  "role": "학습하는 업샘플링 계층",
  "desc": [
   "해상도를 키우는 Conv — 커널 값을 학습",
   "출력 크기는 `tconv_out` 공식"
  ],
  "args": [
   [
    "in, out",
    "입력 · 출력 채널"
   ],
   [
    "kernel_size, stride, padding",
    "커널 · 간격 · 패딩"
   ]
  ],
  "flow": "입력 칸 사이를 stride 만큼 벌려 커널을 겹쳐 더함",
  "ret": "텐서 (N, out, H′, W′)",
  "hdr": "torch.nn"
 },
 "nn.Upsample()": {
  "role": "학습 없는 업샘플링",
  "desc": [
   "`bilinear` 보간으로 크기를 키움 — 파라미터 없음",
   "보통 뒤에 Conv 를 붙임"
  ],
  "args": [
   [
    "scale_factor",
    "배율 (2 = 2배)"
   ],
   [
    "mode",
    "보간 방식 (\"bilinear\")"
   ],
   [
    "align_corners",
    "모서리 정렬 여부 (False)"
   ]
  ],
  "flow": "주변 픽셀을 섞어 새 픽셀 계산",
  "ret": "텐서 (N, C, 2H, 2W)",
  "hdr": "torch.nn"
 },
 "miou()": {
  "role": "클래스별 IoU 와 평균 mIoU",
  "desc": [
   "클래스마다 `(교집합) / (합집합)` 픽셀 수",
   "합집합 0 이면 `nan` → `nanmean` 으로 제외",
   "4×4 예제: [0.5, 0.6667] → 0.5833"
  ],
  "args": [
   [
    "pred",
    "예측 라벨 지도"
   ],
   [
    "gt",
    "정답 라벨 지도"
   ],
   [
    "n_cls",
    "클래스 수 (배경 포함)"
   ]
  ],
  "flow": "클래스 c 마다 p = pred==c, g = gt==c → IoU → 평균",
  "ret": "(IoU 배열, mIoU)"
 },
 "seg_person_mask()": {
  "role": "YOLOv8-seg 결과 → 사람 마스크(0/1)",
  "desc": [
   "`classes=[0]` 로 사람만 예측",
   "`r.masks.xy` 외곽선을 `cv2.fillPoly` 로 원본 크기 마스크에 채움",
   "사람 0명이면 `r.masks is None`"
  ],
  "args": [
   [
    "model",
    "YOLO seg 모델"
   ],
   [
    "img_bgr",
    "BGR 이미지"
   ],
   [
    "conf",
    "점수 기준 (0.25)"
   ]
  ],
  "flow": "predict → 외곽선마다 fillPoly",
  "ret": "(H×W uint8 마스크, 사람 수)"
 },
 "cv2.fillPoly()": {
  "role": "다각형 안을 한 값으로 채움",
  "desc": [
   "마스크 만들기 · 위험구역 칠하기에 쓴다",
   "다각형은 `int32` 배열의 리스트"
  ],
  "args": [
   [
    "img",
    "그릴 배열"
   ],
   [
    "pts",
    "[다각형 점 (N, 2) int32]"
   ],
   [
    "color",
    "채울 값 / 색"
   ]
  ],
  "flow": "다각형 내부 픽셀 = color",
  "ret": "img (제자리 수정)",
  "hdr": "import cv2"
 },
 "run_pose()": {
  "role": "YOLOv8-pose 결과를 numpy 로",
  "desc": [
   "관절 `(사람, 17, 2)` · 신뢰도 `(사람, 17)` · 박스 `(사람, 4)` 를 돌려줌"
  ],
  "args": [
   [
    "model",
    "YOLO pose 모델"
   ],
   [
    "img_bgr",
    "BGR 이미지"
   ],
   [
    "conf",
    "점수 기준"
   ]
  ],
  "flow": "predict → keypoints.xy · conf, boxes.xyxy → cpu().numpy()",
  "ret": "(kpts, confs, boxes)"
 },
 "angle()": {
  "role": "점 b 에서 a-b-c 가 이루는 각도",
  "desc": [
   "`arccos(BA·BC / (|BA||BC| + 1e-9))` 를 도(°) 로",
   "직각 90° · 일직선 180°"
  ],
  "args": [
   [
    "a, b, c",
    "점 (b 가 꼭짓점)"
   ]
  ],
  "flow": "벡터 BA, BC → 내적 → clip → arccos → degrees",
  "ret": "float (도)"
 },
 "body_tilt()": {
  "role": "몸통과 수직선 사이 각도",
  "desc": [
   "어깨 중점 `(5, 6)` 과 엉덩이 중점 `(11, 12)` 사용",
   "위쪽 수직 = `[0, -1]` (이미지 y 는 아래가 +)",
   "서 있으면 ≈ 0°, 누우면 ≈ 90°"
  ],
  "args": [
   [
    "kpts",
    "관절 좌표 (17, 2)"
   ]
  ],
  "flow": "hip 에서 (위쪽, 어깨 중점) 사이 angle",
  "ret": "float (도)"
 },
 "is_fallen()": {
  "role": "쓰러짐 판정",
  "desc": [
   "기울기 > thr(60°) 이면 True",
   "어깨 · 엉덩이 conf 가 min_conf(0.5) 미만이면 판정 보류 `None`"
  ],
  "args": [
   [
    "kpts",
    "관절 좌표"
   ],
   [
    "conf",
    "관절 신뢰도"
   ],
   [
    "thr",
    "임계 각도 (60)"
   ],
   [
    "min_conf",
    "최소 신뢰도 (0.5)"
   ]
  ],
  "flow": "conf 확인 → body_tilt → 비교",
  "ret": "True / False / None"
 },
